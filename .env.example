# Required on every optional workstation worker
CAREER_SITE_URL=https://YOUR-PRIVATE-SITE.chatgpt.site
CAREER_SITE_BYPASS_TOKEN=
CAREER_PROXY_SECRET=
CAREER_WORKER_CALLBACK_SECRET=

# ChatGPT-subscription Codex execution
CODEX_COMMAND=codex
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=high
CAREER_MOCK_CODEX=0

# Worker capacity and legacy local-operation behavior
CAREER_CLOUD_WORKER_CONCURRENCY=4
CAREER_ANALYSIS_CONCURRENCY=20
CAREER_DISABLE_OPERATION_WORKER=1

# Cloudflare command
CAREER_CLOUDFLARED_COMMAND=cloudflared

# Choose one tunnel mode. All paths must be absolute on the current machine.
# Current locally managed tunnel (recommended for the existing PC/laptop setup):
# CAREER_TUNNEL_ID=YOUR-TUNNEL-ID
# TUNNEL_CRED_FILE=/absolute/path/to/.cloudflared/YOUR-TUNNEL-ID.json
# TUNNEL_URL=http://127.0.0.1:8010

# Or use a locally managed YAML config:
# CAREER_TUNNEL_CONFIG=/absolute/path/to/.cloudflared/career-automation.yml

# Or, only for a remotely managed tunnel, prefer a protected token file:
# TUNNEL_TOKEN_FILE=/absolute/path/to/private/career-tunnel.token
# TUNNEL_TOKEN=

# Portable machine-local defaults are used when these stay unset.
# Do not share OUTPUT_DIR between concurrently running computers.
# DATA_DIR=/absolute/machine-local/path
# OUTPUT_DIR=/absolute/machine-local/path
# Set only while publishing a changed resume with scripts/career init-profile.
# RESUME_PATH=/absolute/path/to/resume.docx

# Legacy local direct-search tuning only. Production search and SERPAPI_API_KEY
# are configured in the Site environment, not in the workstation .env.
# SERPAPI_API_KEY=
# SERPAPI_POLL_INTERVAL_SECONDS=2
# SERPAPI_POLL_TIMEOUT_SECONDS=120
# SERPAPI_MAX_PAGES=3
# SERPAPI_PAGE3_MIN_NEW_OPPORTUNITIES=3
