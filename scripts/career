#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
ROOT_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/bin:$PATH"
cd "$ROOT_DIR"

if [[ -x "$ROOT_DIR/.venv/bin/python" ]]; then
  exec "$ROOT_DIR/.venv/bin/python" -m career_workflow.cli "$@"
elif command -v uv >/dev/null 2>&1; then
  exec uv run --with-requirements "$ROOT_DIR/requirements.txt" python -m career_workflow.cli "$@"
elif command -v python3 >/dev/null 2>&1; then
  exec python3 -m career_workflow.cli "$@"
else
  echo "Career Automation requires Python 3.11+ or uv." >&2
  exit 127
fi
